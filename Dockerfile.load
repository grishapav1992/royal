# syntax=docker/dockerfile:1
# Isolated Linux x64 test image. This does not reuse a production image or data.
FROM golang:1.27.2-bookworm AS cards
WORKDIR /cards
COPY server/card-engine ./
RUN CGO_ENABLED=0 go build -trimpath -o /card-engine .
WORKDIR /cards-v1
COPY server/card-engine-v1 ./
RUN CGO_ENABLED=0 go build -trimpath -o /card-engine-v1 .

FROM caddy:2.10.2-alpine AS proxy

FROM node:22-bookworm-slim AS build
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --include=dev --include=optional
COPY tsconfig.json vite.config.ts index.html ./
COPY src ./src
COPY server ./server
COPY public ./public
COPY scripts/build-load-stand.mjs scripts/crypto-reconcile.ts scripts/database-test.ts \
    scripts/load-stand-database.ts scripts/load-generator-completion.ts scripts/load-account-probe.ts scripts/load-websocket-cluster.ts scripts/load-server-metrics.ts \
    scripts/temporary-redis.ts scripts/load-stand-control.ts scripts/load-stand-contract.ts \
    scripts/load-stand-limits.ts scripts/websocket-server-diagnostics.ts scripts/load-websocket-diagnostics.ts ./scripts/
RUN npm run build && node scripts/build-load-stand.mjs
RUN node_modules/.bin/esbuild scripts/load-account-probe.ts --bundle --platform=node --packages=external --format=esm --target=node22 --outfile=dist-load/account-probe.mjs
RUN test -x node_modules/@embedded-postgres/linux-x64/native/bin/postgres

FROM node:22-bookworm-slim
ENV NODE_ENV=test HOME=/home/node \
    ROYAL_CADDY_BINARY=/usr/local/bin/caddy ROYAL_REDIS_SERVER_BINARY=/usr/bin/redis-server
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends redis-server ca-certificates procps \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/node_modules/@embedded-postgres/linux-x64 ./node_modules/@embedded-postgres/linux-x64
COPY --from=build /app/dist ./dist
COPY --from=build /app/dist-server ./dist-server
COPY --from=build /app/dist-load ./dist-load
COPY --from=cards /card-engine ./dist-server/card-engine
COPY --from=cards /card-engine-v1 ./dist-server/card-engine-v1
COPY --from=proxy /usr/bin/caddy /usr/local/bin/caddy
# A new inode removes file capabilities that prevent execution with cap-drop ALL.
RUN test ! -e /usr/local/bin/caddy.no-file-caps \
    && cat /usr/local/bin/caddy > /usr/local/bin/caddy.no-file-caps \
    && chmod 0755 /usr/local/bin/caddy.no-file-caps \
    && mv /usr/local/bin/caddy.no-file-caps /usr/local/bin/caddy
RUN mkdir -p /app/run && chown node:node /app/run && chmod 700 /app/run \
    && /usr/local/bin/caddy version && /usr/bin/redis-server --version && test -x /bin/ps

# Exercise the actual compiled wrapper under UID node, including native initdb,
# startup, SQL and cleanup. The probe stores no database or credentials in layers.
RUN printf '%s\n' \
    'import pg from "pg"; import { readdir } from "node:fs/promises";' \
    'const flag = process.argv.indexOf("--expected-connections"); const expected = Number(process.argv[flag + 1]); if (flag < 0 || ![154, 178].includes(expected)) throw Error("probe-expected-limit");' \
    'const client = new pg.Client(); try { await client.connect(); const result = await client.query("SELECT 1 AS value"); const limit = await client.query("SHOW max_connections"); if (result.rows[0]?.value !== 1 || Number(limit.rows[0]?.max_connections) !== expected) throw Error("probe"); } finally { await client.end(); }' \
    'if (!(await readdir("/tmp")).some(name => name.startsWith("royal-pg-"))) throw Error("temporary-database-missing");' \
    > /app/load-db-probe.mjs
USER node
RUN node dist-load/database.mjs /app/load-db-probe.mjs --expected-connections 154 --game-processes 20 \
    && node --input-type=module -e 'import { readdir } from "node:fs/promises"; if ((await readdir("/tmp")).some(name => name.startsWith("royal-pg-"))) process.exit(1); console.log("temporary PostgreSQL 20-process init/start/query/limit154/cleanup passed under UID node");' \
    && node dist-load/database.mjs /app/load-db-probe.mjs --expected-connections 178 --game-processes 24 \
    && node --input-type=module -e 'import { readdir } from "node:fs/promises"; if ((await readdir("/tmp")).some(name => name.startsWith("royal-pg-"))) process.exit(1); console.log("temporary PostgreSQL 24-process init/start/query/limit178/cleanup passed under UID node");' \
    && node dist-load/database.mjs /app/dist-load/account-probe.mjs --game-processes 20 \
    && node --input-type=module -e 'import { readdir } from "node:fs/promises"; if ((await readdir("/tmp")).some(name => name.startsWith("royal-pg-"))) process.exit(1); console.log("temporary PostgreSQL account login/select0..5/session/read/cleanup passed under UID node");' \
    && node dist-load/cluster.mjs --help
USER root
RUN rm /app/load-db-probe.mjs
USER node
ENTRYPOINT ["node", "dist-load/database.mjs", "dist-load/cluster.mjs", "--metrics-script", "/app/dist-load/metrics.mjs", "--server-bundle", "/app/dist-server/index.js", "--proxy-binary", "/usr/local/bin/caddy"]
CMD ["--help"]
