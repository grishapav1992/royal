SITE_DOMAIN=play.example.com
PUBLIC_ORIGIN=https://play.example.com
CODEX_SALE_API_KEY=
CODEX_SALE_NPC_MODEL=gpt-6-luna
MIRA_PROVIDER=codex-sale
VENICE_API_KEY=
VENICE_NPC_MODEL=venice-uncensored-role-play

# Per game process. Ten rooms allow at most 300 occupied or reserved seats.
# Increase total capacity by distributing rooms across processes after load testing.
LOBBY_MAX_ROOMS=10
WS_MAX_CONNECTIONS=330
LOBBY_AUTH_CONCURRENCY=8
LOBBY_MATCHMAKING_RATE=30
LOBBY_MATCHMAKING_BURST=60
WS_MAX_BUFFERED_BYTES=262144
# Optional multi-process overlay uses its own private Redis-compatible service.
# For manual process startup, set REDIS_URL and a unique LOBBY_WORKER_ID.
# PUBLIC_ORIGIN stays the public origin, for example https://example.com.
# Additional workers serve WebSockets only; API and background jobs run on main.
LOBBY_WORKER_PGPOOL_MAX=6
LOBBY_WORKER_AUTH_CONCURRENCY=4

# HTTP API limits run before body parsing and session database lookups.
# Reuse REDIS_URL for shared counters; a dedicated Redis URL can also be supplied.
# Without Redis, limits are local to a single process. Replicas must share one URL
# and the same PUBLIC_ORIGIN. Redis failure returns 503 without a local fallback.
# HTTP_RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379/0
# Browser traffic and signed payment callbacks have separate IP budgets.
HTTP_RATE_LIMIT_IP_PER_MINUTE=1800
HTTP_RATE_LIMIT_IP_BURST=180
HTTP_RATE_LIMIT_CALLBACK_PER_MINUTE=6000
HTTP_RATE_LIMIT_CALLBACK_BURST=600
# Burst windows are 10 seconds. Values are per IP; allow for users sharing NAT.
# IPv6 uses a shared /64 budget. IPv4-mapped IPv6 uses the IPv4 address budget.
# Wallet account budgets per minute: 240 total, 120 reads, 180 game actions,
# 20 deposit/quote/claim requests, 5 withdrawals, 30 operation refreshes.
# Crypto additionally keeps its existing total of 60 requests per minute.
# Demo wallet: 240 per minute. Login: 80/IP and 10/email per 15 minutes.

# One PostgreSQL database; game data uses the royal_game schema.
# Use a separate development database locally and never production credentials.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=royal_finance_sim
PGUSER=royal_game_app
PGPASSWORD=
PGSSLMODE=disable
# Budget this maximum across all service replicas.
PGPOOL_MAX=10
PGPOOL_IDLE_MS=30000
PGCONNECT_TIMEOUT_MS=5000
PGSTATEMENT_TIMEOUT_MS=15000
PGLOCK_TIMEOUT_MS=5000
PGIDLE_TX_TIMEOUT_MS=90000
# PGAPPNAME=royal-game
# PGPASSWORD_FILE=/path/to/game-password
# DATABASE_URL_FILE=/path/to/database-url
# For external connections: PGSSLMODE=verify-full and PGSSLROOTCERT=/path/to/ca.pem

# Casino Api Pro: sandbox only. Keep credentials on the server.
CASINOAPIPRO_ENABLED=false
CASINOAPIPRO_API_KEY=
CASINOAPIPRO_API_SECRET=
CASINOAPIPRO_WALLET_SECRET=
CASINOAPIPRO_CURRENCY=USD

# NOWPayments: activate only after merchant onboarding and a real payment/payout check.
# USDT TRC20 must be the sole primary Custody settlement balance in the dashboard.
NOWPAYMENTS_ENABLED=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_WITHDRAWALS_ENABLED=false
NOWPAYMENTS_GAMES_ENABLED=false
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
NOWPAYMENTS_2FA_SECRET=
NOWPAYMENTS_CONVERSION_MARGIN_BPS=100
# Secrets also accept _FILE variants. Never commit credentials or the 2FA secret.

# Separate local finance simulation. No real wallets or payments.
# Financial dashboard: comma-separated immutable IDs of existing accounts. Empty denies access.
FINANCE_ADMIN_ACCOUNT_IDS=
FINANCE_MODE=simulation
FINANCE_DATABASE_URL=
FINANCE_MIGRATION_DATABASE_URL=
FINANCE_SANDBOX_TOKEN=
FINANCE_PORT=2570
# Local private database only. External connections require verify-full.
FINANCE_DB_TLS=disabled
FINANCE_DB_POOL_MAX=10
# FINANCE_DB_CA_FILE=/path/to/trusted-ca.pem
# FINANCE_DATABASE_URL_FILE=/path/to/database-url
# FINANCE_MIGRATION_DATABASE_URL_FILE=/path/to/migration-database-url
# Closed simulation deposit observer, using its own restricted database login.
# FINANCE_DEPOSIT_NETWORK=tron-sim-v1
# FINANCE_DEPOSIT_SOURCE_A_FILE=/path/to/source-a.json
# FINANCE_DEPOSIT_SOURCE_B_FILE=/path/to/source-b.json
