FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json tsconfig.finance.json ./
RUN npm ci
COPY server/database.ts server/database-migrations.ts ./server/
COPY server/finance ./server/finance
COPY server/games ./server/games
COPY src/shared ./src/shared
COPY scripts/finance-*.ts scripts/database-archive.ts ./scripts/
COPY server-tests/finance ./server-tests/finance
RUN npm run check:finance && npx esbuild scripts/finance-nile-play.ts --bundle --platform=node --external:pg --external:pg-native --format=esm --outfile=play.js
RUN npx esbuild scripts/finance-nile-play-proof.ts --bundle --platform=node --external:pg --external:pg-native --format=esm --outfile=proof.js

FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/play.js ./play.js
COPY --from=build /app/proof.js ./proof.js
USER node
CMD ["node", "play.js", "serve"]
