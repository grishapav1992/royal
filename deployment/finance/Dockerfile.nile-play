FROM golang:1.27.2-bookworm AS cards
WORKDIR /cards
COPY server/card-engine ./
RUN CGO_ENABLED=0 go build -trimpath -o /card-engine .
FROM golang:1.27.2-bookworm AS legacy-cards
WORKDIR /cards
COPY server/card-engine-v1 ./
RUN CGO_ENABLED=0 go build -trimpath -o /card-engine-v1 .
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json tsconfig.finance.json ./
RUN npm ci
COPY server ./server
COPY src/shared ./src/shared
COPY src/i18n ./src/i18n
COPY scripts/finance-*.ts scripts/database-archive.ts ./scripts/
COPY server-tests/finance ./server-tests/finance
RUN npm run check:finance && npx esbuild scripts/finance-nile-play.ts --bundle --platform=node --external:pg --external:pg-native --format=esm --outfile=play.js
RUN npx esbuild scripts/finance-nile-play-proof.ts --bundle --platform=node --external:pg --external:pg-native --format=esm --outfile=proof.js

FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/play.js ./play.js
COPY --from=build /app/proof.js ./proof.js
COPY --from=cards /card-engine ./dist-server/card-engine
COPY --from=legacy-cards /card-engine-v1 ./dist-server/card-engine-v1
USER node
CMD ["node", "play.js", "serve"]
