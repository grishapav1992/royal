FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json tsconfig.finance.json ./
RUN npm ci
COPY server/database.ts server/database-migrations.ts ./server/
COPY server/finance ./server/finance
COPY server/admin/report.ts server/admin/validation.ts server/admin/nileGamesReport.ts ./server/admin/
COPY server/crypto/config.ts ./server/crypto/config.ts
COPY server/games ./server/games
COPY src/shared ./src/shared
COPY scripts/finance-*.ts scripts/database-archive.ts ./scripts/
COPY server-tests/finance ./server-tests/finance
RUN npm run check:finance \
    && npx esbuild scripts/finance-nile-reconcile.ts --bundle --platform=node --external:pg --external:pg-native --format=esm --outfile=dist-nile/reconcile.js \
    && npx esbuild scripts/finance-nile-deposit-proof.ts --bundle --platform=node --external:pg --external:pg-native --format=esm --outfile=dist-nile/proof.js

FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist-nile/reconcile.js ./reconcile.js
COPY --from=build /app/dist-nile/proof.js ./proof.js
USER node
CMD ["node", "reconcile.js"]
