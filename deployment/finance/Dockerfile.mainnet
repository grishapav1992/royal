FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY server/database.ts server/database-migrations.ts ./server/
COPY server/finance ./server/finance
COPY server/admin/report.ts server/admin/validation.ts server/admin/nileGamesReport.ts ./server/admin/
COPY server/crypto/config.ts ./server/crypto/config.ts
COPY server/games ./server/games
COPY src/shared ./src/shared
COPY scripts/finance-mainnet.ts scripts/database-archive.ts ./scripts/
RUN npx esbuild scripts/finance-mainnet.ts --bundle --platform=node --external:pg --external:pg-native --format=esm --outfile=mainnet.js

FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/mainnet.js ./mainnet.js
USER node
CMD ["node", "mainnet.js", "serve"]
