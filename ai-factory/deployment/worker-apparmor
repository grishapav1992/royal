# Candidate confined container profile for a temporary sandbox probe.
# Do not install persistently before the Linux smoke and explicit approval.
# Based on Docker 29.1.3, Moby commit fbf3ed25f893e6ce21336f1101590e40a13934f4:
# vendor/github.com/moby/profiles/apparmor/template.go
# Keep Codex command sandboxing and no-new-privileges enabled.
abi <abi/4.0>,
include <tunables/global>

profile royal-ai-worker-test flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>

  network,
  capability,
  file,
  umount,
  userns,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=royal-ai-worker-test,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # Bubblewrap 0.8.0 makes the new mount namespace private, builds a tmpfs
  # staging root and bind-mounts only into that staging root.
  mount options=(rw,rslave,silent) -> /,
  mount fstype=tmpfs options=(rw,nosuid,nodev) tmpfs -> /tmp/,
  mount options=(rw,rbind,silent) -> /tmp/newroot/,
  # Observed Codex 0.162.0 setup operations at the staging-root directory.
  mount fstype=tmpfs options=(rw,nosuid,nodev) tmpfs -> /newroot/,
  mount options=(rw,rbind) /oldroot/ -> /newroot/,
  # Observed read-only remount of the staging-root directory itself.
  remount options=(ro,nosuid,nodev,bind,silent,relatime) /newroot/,
  mount options in (rw,ro,bind,rbind,remount,nosuid,suid,nodev,dev,noexec,exec,noatime,atime,nodiratime,diratime,relatime,norelatime,strictatime,silent) -> /newroot/**,
  mount fstype=(tmpfs,proc,devpts) -> /newroot/**,
  mount options=(rw,rprivate,silent) -> /oldroot/,
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  pivot_root /newroot/,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=royal-ai-worker-test,
}
