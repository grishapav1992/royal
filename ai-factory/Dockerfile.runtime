FROM node:24-bookworm-slim
USER root
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl procps bubblewrap && rm -rf /var/lib/apt/lists/*
RUN npm install -g @openai/codex@0.162.0 --ignore-scripts --no-audit --no-fund
RUN test -x /usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/bin/codex && ln -s /usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/bin/codex /usr/local/bin/codex-linux-sandbox
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
RUN npm install --prefix /opt/browser @playwright/test@1.58.2 --ignore-scripts --no-audit --no-fund && /opt/browser/node_modules/.bin/playwright install --with-deps chromium && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /home/node/.codex /workspaces /data /artifacts /tmp/factory-test-home && chown -R node:node /home/node/.codex /workspaces /data /artifacts /tmp/factory-test-home
USER node
