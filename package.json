{
  "name": "royal-arcade-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "work:sync": "node scripts/sync-work.mjs",
    "work:start": "node scripts/sync-work.mjs --new",
    "test:work-sync": "node --test server-tests/work-sync.test.mjs",
    "dev": "npm run build:modules && concurrently -k -n web,server \"vite --host 0.0.0.0\" \"npm run dev:server\"",
    "build": "node scripts/build-application.mjs",
    "release:plan": "node scripts/release.mjs plan",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:verify": "node scripts/release.mjs verify",
    "test:release": "node --test server-tests/release-tooling.test.mjs",
    "check:rtp": "node scripts/check-game-rtp.mjs",
    "analyze:forest-heart": "node --import tsx scripts/game-math/forest-heart-model.mjs",
    "test:forest-heart-math": "node --import tsx --test server-tests/forest-heart-math.test.ts server-tests/forest-heart-rtp.test.mjs",
    "qualify:rtp": "node --import tsx scripts/qualify-game-rtp.mjs",
    "test:rtp-gate": "node --test server-tests/rtp-gate.test.mjs server-tests/cosmic-rtp-gate.test.mjs server-tests/forest-heart-runtime-rtp.test.mjs",
    "test:forest-heart-server": "node --import tsx scripts/database-test.ts --import tsx --test server-tests/forest-heart-protocol.test.ts server-tests/forest-heart-wallet.test.ts server-tests/forest-heart-http.test.ts",
    "test:slot-balance": "node --import tsx scripts/database-test.ts --import tsx --test server-tests/neopolis-math.test.ts server-tests/neopolis-wallet.test.ts server-tests/neopolis-catalog.test.ts server-tests/dracona-math.test.ts server-tests/dracona-protocol.test.ts server-tests/dracona-wallet.test.ts server-tests/rebalanced-slots-http.test.ts server-tests/finance/nile-native-games.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "build:admin": "tsc --noEmit && vite build --config vite.admin.config.ts",
    "test": "playwright test",
    "dev:web": "npm run build:modules && vite --host 0.0.0.0",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "check:room": "tsx scripts/check-room.ts",
    "casinoapipro:prepare": "tsx scripts/casinoapipro-prepare.ts",
    "casinoapipro:check": "node --env-file-if-exists=.env --import tsx scripts/casinoapipro-check.ts",
    "test:auth": "node --import tsx scripts/database-test.ts --import tsx --test server-tests/*.test.ts",
    "test:finance": "node --import tsx scripts/database-test.ts --import tsx --test server-tests/finance/*.test.ts",
    "test:e2e:pg": "node --import tsx scripts/database-test.ts node_modules/@playwright/test/cli.js test",
    "database:migrate": "node --import tsx scripts/database-migrate.ts",
    "check:finance": "tsc --noEmit -p tsconfig.finance.json",
    "build:finance": "npm run check:finance && esbuild server/finance/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist-server/finance.js",
    "finance:migrate": "node --env-file-if-exists=.env --import tsx scripts/finance-migrate.ts",
    "finance:dev": "node --env-file-if-exists=.env --import tsx server/finance/index.ts",
    "finance:demo": "tsx scripts/finance-demo.ts",
    "build:cards": "node scripts/build-card-engine.mjs",
    "payments:dev": "node --env-file-if-exists=.env.payments --import tsx server/payments/index.ts",
    "build:modules": "node scripts/build-game-module.mjs --all",
    "test:modules": "npm run build:modules && node --import tsx --test server-tests/independent-modules.test.ts server-tests/game-module-assets.test.ts && playwright test --config=playwright.modules.config.ts",
    "dev:atelier": "node --import tsx scripts/local-atelier.ts",
    "test:skins": "node --import tsx scripts/database-test.ts --import tsx --test server-tests/skin-studio.test.ts server-tests/skin-profile.test.ts server-tests/skin-common-wallet.test.ts",
    "test:skins:ui": "playwright test --config playwright.skins.config.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/schema": "^5.0.35",
    "@colyseus/sdk": "^0.18.4",
    "@colyseus/ws-transport": "^0.18.4",
    "chess.js": "^1.4.0",
    "express": "^5.2.1",
    "pg": "8.23.1",
    "phaser": "3.90.0",
    "qrcode-generator": "2.0.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@noble/hashes": "2.4.0",
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "8.23.1",
    "concurrently": "^10.0.5",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "^0.28.2",
    "jsqr": "1.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "overrides": {
    "concurrently": {
      "shell-quote": "1.11.0"
    }
  }
}
